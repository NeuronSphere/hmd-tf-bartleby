{
  "identifier": "hmd-tf-bartleby",
  "name": "hmd-tf-bartleby",
  "description": "Runs the document generation transform",
  "project_type": {
    "name": "transform"
  },
  "docker": {
    "build": {
      "context_dir": "./",
      "install_local": true
    }
  },
  "build": {
    "commands": [
      [
        "python"
      ],
      [
        "docker"
      ]
    ]
  },
  "deploy": {},
  "bartleby": {
    "roots": {
      "index": {
        "root_doc": "index",
        "builders": [
          "html",
          "pdf"
        ],
        "config": {
          "needs_id_regex": "^HMD_[A-Z0-9_]+$",
          "needs_warnings": {
            "requirement_without_test": "type == 'req' and not links_back and 'trace-exempt' not in tags"
          }
        }
      }
    }
  }
}
